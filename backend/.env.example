# Guardian.AI backend environment
# Copy to backend/.env for local dev. Never commit real keys.

# --- Required for AI verdict (Groq) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# AI model used for threat verdict generation
AI_MODEL=openai/gpt-oss-20b

# --- CORS (comma-separated origins). Defaults keep local Vite dev if unset.
# Production: include your Vercel frontend origin, e.g.
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Web3 / on-chain registry (Module 6) ---
# Local dev (default): Hardhat node
WEB3_RPC_URL=http://127.0.0.1:8545
# Sepolia (or other network): set the deployer account private key to sign transactions.
# Leave EMPTY for local Hardhat dev (uses an unlocked node account). NEVER commit a real key.
PRIVATE_KEY=

# --- Threat intelligence (optional) ---
VIRUSTOTAL_API_KEY=your_key_here
ABUSEIPDB_API_KEY=your_key_here
OTX_API_KEY=your_key_here

# Optional: urlscan.io community scan search (free key, used by link investigations)
# URLSCAN_API_KEY=your_key_here
# Optional: abuse.ch Auth-Key for URLhaus (reporting only — URLhaus lookups work without it)
# URLHAUS_API_KEY=your_key_here

# --- Standalone link investigator limits (optional — defaults shown) ---
# LINK_FETCH_TIMEOUT=5
# LINK_TLS_TIMEOUT=5
# LINK_CT_TIMEOUT=5
# LINK_MAX_REDIRECTS=5
# LINK_MAX_RESPONSE_BYTES=1048576
# LINK_CT_MAX_BYTES=1048576
# CT_LOG_URL=https://crt.sh

# Web3 (Sepolia) — do not commit real values; set on the host (Render dashboard) or in backend/.env locally
# WEB3_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PRIVATE_KEY=0xYOUR_SEPOLIA_DEPLOYER_PRIVATE_KEY_HERE
