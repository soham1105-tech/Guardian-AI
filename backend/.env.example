# Groq API key — get yours free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# AI model used for threat verdict generation
# Run `client.models.list()` to see all models available on your account
AI_MODEL=openai/gpt-oss-20b

VIRUSTOTAL_API_KEY=your_key_here
ABUSEIPDB_API_KEY=your_key_here
OTX_API_KEY=your_key_here

# Optional: urlscan.io community scan search (free key, used by link investigations)
URLSCAN_API_KEY=your_key_here
# Optional: abuse.ch Auth-Key for URLhaus (reporting only — URLhaus lookups work without it)
URLHAUS_API_KEY=your_key_here

# Standalone link investigator limits (optional — these are the defaults)
# LINK_FETCH_TIMEOUT=5
# LINK_TLS_TIMEOUT=5
# LINK_CT_TIMEOUT=5
# LINK_MAX_REDIRECTS=5
# LINK_MAX_RESPONSE_BYTES=1048576
# LINK_CT_MAX_BYTES=1048576
# CT_LOG_URL=https://crt.sh