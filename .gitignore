# =========================================================
# Guardian.AI specific
# =========================================================

# Uploaded .eml files should never be committed (may contain
# real user data / PII if someone tests with a real email).
# Keep the folder tracked via .gitkeep, ignore its contents.
backend/uploads/*
!backend/uploads/.gitkeep

# Sample emails are fine to keep (synthetic test data),
# but exclude any locally-added real captured emails if named like this:
backend/sample_emails/real_*.eml

# Downloaded/generated investigation reports (V3 feature)
backend/reports/*
!backend/reports/.gitkeep


